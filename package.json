{
  "name": "arbora",
  "version": "1.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/api\"",
    "gen:database": "npm run generate --workspace @arbora/database",
    "build:database": "npm run build --workspace @arbora/database",
    "build:shared": "npm run build --workspace @arbora/shared",
    "build:api": "npm run build --workspace api",
    "build:web": "npm run build --workspace arbora",
    "build": "npm run build:database && npm run build:shared && npm run build:api && npm run build:web",
    "test:api": "npm run test --workspace api",
    "test:api:integration": "npm run test:integration --workspace api",
    "test:web": "npm run test --workspace arbora"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "~5.9.3"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
