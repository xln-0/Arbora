model Event {
  id String @id @default(uuid())

  treeId String

  tree FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  type EventType

  personId String

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  relationshipId String?

  relationship Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  title String?

  date DateTime @db.Date

  place String?

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([treeId, date])
  @@index([treeId, type])
  @@index([personId])
  @@index([relationshipId])
}

enum EventType {
  BIRTH
  BAPTISM
  EDUCATION
  OCCUPATION
  RESIDENCE
  FREE_UNION
  MARRIAGE
  DIVORCE
  DEATH
  BURIAL
  OTHER
}
