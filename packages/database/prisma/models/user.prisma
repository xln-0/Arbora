model User {
    id String @id @default(uuid())

    email String @unique

    passwordHash String?

    role AppRole @default(USER)

    createdAt DateTime @default(now())

    trees FamilyTree[] @relation("OwnedTrees")

    sessions Session[]

    memberships TreeMember[]
}

enum AppRole {
    ADMIN
    USER
}

model Session {
    id String @id @default(uuid())

    userId String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    expiresAt DateTime

    createdAt DateTime @default(now())
}
