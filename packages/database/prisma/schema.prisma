generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email String @unique

  passwordHash String?

  createdAt DateTime @default(now())

  trees FamilyTree[]

  sessions Session[]
}

model Session {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

model FamilyTree {
  id String @id @default(uuid())

  name String

  ownerId String

  owner User @relation(fields: [ownerId], references: [id])

  persons Person[]

  createdAt     DateTime       @default(now())
  relationships Relationship[]
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum RelationshipType {
  PARENT
  CHILD
  PARTNER
}

model Person {
  id String @id @default(uuid())

  treeId String

  tree FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  firstName String

  lastName String?

  gender Gender @default(UNKNOWN)

  birthDate DateTime?

  deathDate DateTime?

  positionX Float @default(0)

  positionY Float @default(0)

  createdAt DateTime @default(now())

  relationshipsFrom Relationship[] @relation("sourceRelationships")

  relationshipsTo Relationship[] @relation("targetRelationships")
}

model Relationship {
  id String @id @default(uuid())

  treeId String

  tree FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  type RelationshipType

  sourcePersonId String

  sourcePerson Person @relation("sourceRelationships", fields: [sourcePersonId], references: [id], onDelete: Cascade)

  targetPersonId String

  targetPerson Person @relation("targetRelationships", fields: [targetPersonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
